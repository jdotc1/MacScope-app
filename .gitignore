MacScope/DependencyRoots.local.xcconfig

# Verified direct-source Swift package materializations are machine-local inputs.
# bootstrap.sh links this ignored path only after independent identity verification.
MacScope/LocalPackages

# Build-station claim (Scripts/station.sh, D12)
.station-claim

# Local machine configuration (work root); never commit
.env.local
*.pyc
