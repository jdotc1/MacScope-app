# Python bytecode caches are generated local artifacts, never source inputs.
__pycache__/

# Licensed reference-tool bundle components (copyright) — never commit or push.
# Matched by a name-free glob: the retired tool's name must not appear in ANY tracked
# file, and .gitignore is tracked. See docs/brand/Nomenclature.md.
*_Disassembler_component_files/

