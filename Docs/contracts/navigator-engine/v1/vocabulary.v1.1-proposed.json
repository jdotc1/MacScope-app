{
  "schemaVersion": 1,
  "contract": "navigator-engine",
  "note": "Closed vocabularies for contract v1. Adding a term is a minor revision (append only); removing or renaming one needs schemaVersion 2. Every term lists the value shape it carries. A predicate marked multi holds a set of values per subject (several stored fields); every other predicate is single-valued, so two different values for one subject are a disagreement. v1.1 (proposed 2026-10-22, not adopted): appended predicates methodTableEntry, conformanceMethod, metadataAccessorOf, pointerAuthKey; appended gaps conflictingFacts, budgetExceeded, producerIncomplete; subject refs follow the canonical grammar in subjectRefGrammar. Existing predicates superclass, isGeneric, isProtocol, fieldLayout, hasType, selectorOf, asyncContinuationOf, viewBodyType, callsTarget have no native producer at e3285cb90 except superclass, isGeneric, isProtocol, isPrivateOrLocal and isImportedCType (#962, projection uncalled).",
  "statuses": [
    "authoritative",
    "proven",
    "derived",
    "candidate",
    "unknown"
  ],
  "subjectKinds": [
    "image",
    "address",
    "range",
    "function",
    "type",
    "metadataRecord",
    "selector",
    "viewBody",
    "protocol",
    "field"
  ],
  "predicates": {
    "isFunctionStart": {
      "value": "boolean"
    },
    "hasName": {
      "value": "string"
    },
    "hasType": {
      "value": "string"
    },
    "callsTarget": {
      "value": "string",
      "multi": true
    },
    "fieldLayout": {
      "value": "object"
    },
    "selectorOf": {
      "value": "string"
    },
    "asyncContinuationOf": {
      "value": "string"
    },
    "viewBodyType": {
      "value": "string"
    },
    "libraryIdentity": {
      "value": "object",
      "shape": "{name, library, libraryVersion?}"
    },
    "nominalKind": {
      "value": "string",
      "enum": [
        "class",
        "struct",
        "enum",
        "protocol"
      ]
    },
    "isGeneric": {
      "value": "boolean"
    },
    "storedField": {
      "value": "object",
      "shape": "{name, type, var}",
      "multi": true
    },
    "enumCase": {
      "value": "object",
      "shape": "{name, payload, indirect}",
      "multi": true
    },
    "superclass": {
      "value": "string"
    },
    "conformsTo": {
      "value": "string",
      "multi": true
    },
    "isProtocol": {
      "value": "boolean"
    },
    "isPrivateOrLocal": {
      "value": "boolean"
    },
    "isImportedCType": {
      "value": "boolean"
    },
    "methodTableEntry": {
      "value": "object",
      "shape": "{index, implementation, name?, kind: vtable|override}",
      "multi": true
    },
    "conformanceMethod": {
      "value": "object",
      "shape": "{protocol, requirementIndex, implementation, name?}",
      "multi": true
    },
    "metadataAccessorOf": {
      "value": "string"
    },
    "pointerAuthKey": {
      "value": "object",
      "shape": "{key: IA|IB|DA|DB, diversity, addressDiversified}"
    }
  },
  "gaps": [
    "unresolvedIndirectCall",
    "unboundGenericParameter",
    "unlinkedAsyncContinuation",
    "unreconstructedViewBody",
    "unknownType",
    "unnamedFunction",
    "unrecoveredStruct",
    "unresolvedObjCSend",
    "unknownCalleeEffects",
    "ambiguousLibraryIdentity",
    "unsupportedToolchain",
    "boundaryUncertain",
    "unresolvedTypeReference",
    "objcTypeReference",
    "unresolvedProtocol",
    "unknownContext",
    "missingFieldDescriptor",
    "malformedFieldDescriptor",
    "unresolvedSymbolicReference",
    "unresolvedConformance",
    "conflictingAnnotations",
    "staleAnnotation",
    "conflictingFacts",
    "budgetExceeded",
    "producerIncomplete"
  ],
  "refusals": [
    "budgetExceeded",
    "cancelled",
    "preconditionFailed",
    "unsupportedToolchain",
    "outOfBounds",
    "malformedInput",
    "unknownSubject",
    "unknownFact",
    "conflictsWithAuthority",
    "notReversible"
  ],
  "provenanceKinds": [
    "loaderRecord",
    "decodedInstruction",
    "metadataRecord",
    "rule",
    "proofCertificate",
    "signatureRecord",
    "analystAction",
    "symbolGraph"
  ],
  "annotationActions": [
    "rename",
    "setType",
    "acceptCandidate",
    "acceptStructCandidate",
    "makeProcedure",
    "addXref",
    "setFact"
  ],
  "annotationAuthors": [
    "analyst",
    "navigator"
  ],
  "minorRevision": "1.1-proposed",
  "subjectRefGrammar": {
    "image": "<uuid>/<sliceSHA256 prefix16>",
    "address": "0x<lowercase hex, no leading zeros>",
    "range": "<address>..<<address>",
    "function": "<address of entry>",
    "type": "<descriptor address>",
    "metadataRecord": "<section>@<address>",
    "selector": "<selector string>",
    "viewBody": "<address of body getter>",
    "protocol": "<descriptor address>",
    "field": "<type ref>#<field index> | <type ref>.<field name>",
    "name": "name:<qualified name>"
  },
  "provenanceRefGrammar": {
    "loaderRecord": "lc[<n>] | section[<segment>,<name>] | <table>[<i>]@<address>",
    "decodedInstruction": "<address>",
    "metadataRecord": "<section>@<address>",
    "rule": "<rule id>@<version>",
    "proofCertificate": "sha256:<hex>",
    "signatureRecord": "<corpus>/<record id>",
    "analystAction": "ann:<session>/<seq>",
    "symbolGraph": "<module>:<usr>"
  }
}
