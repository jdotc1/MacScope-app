MACSCOPE_PCODE_OPCODE(CPUI_INT_ADD            , "INT_ADD"           , "int_add")
MACSCOPE_PCODE_OPCODE(CPUI_INT_SUB            , "INT_SUB"           , "int_sub")
MACSCOPE_PCODE_OPCODE(CPUI_INT_CARRY          , "INT_CARRY"         , "int_carry")
MACSCOPE_PCODE_OPCODE(CPUI_INT_SCARRY         , "INT_SCARRY"        , "int_scarry")
MACSCOPE_PCODE_OPCODE(CPUI_INT_SBORROW        , "INT_SBORROW"       , "int_sborrow")
