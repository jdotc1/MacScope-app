MACSCOPE_PCODE_OPCODE(CPUI_INT_SLESS          , "INT_SLESS"         , "int_sless")
MACSCOPE_PCODE_OPCODE(CPUI_INT_SLESSEQUAL     , "INT_SLESSEQUAL"    , "int_slessequal")
MACSCOPE_PCODE_OPCODE(CPUI_INT_LESS           , "INT_LESS"          , "int_less")
MACSCOPE_PCODE_OPCODE(CPUI_INT_LESSEQUAL      , "INT_LESSEQUAL"     , "int_lessequal")
MACSCOPE_PCODE_OPCODE(CPUI_INT_ZEXT           , "INT_ZEXT"          , "int_zext")
