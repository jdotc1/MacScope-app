        "localRecordCount": {
          "const": 0
        },
        "nativeBasicBlockCount": {
          "const": 0
        },
        "nativeCFGEdgeCount": {
          "const": 0
        },
        "recoveredVariableCount": {
          "const": 0
        },
        "typeCandidateCount": {
          "const": 0
        }
      },
      "required": [
        "carrierBytes",
        "rawFunctionBytes",
        "effectiveFunctionBytes",
        "appliedPatchCount",
        "unmappedEvidenceCount",
        "pseudocodeBytes",
        "nativeInstructionCount",
        "nativeInstructionBytes",
        "nativeFunctionRecordCount",
        "tokenCount",
        "localRecordCount",
        "nativeBasicBlockCount",
        "nativeCFGEdgeCount",
        "recoveredVariableCount",
        "typeCandidateCount"
      ]
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "analysisLevel",
    "contractCompleteness",
    "requestId",
    "requestSha256",
    "engine",
    "authority",
    "function",
    "capabilities",
    "analysisSemantics",
    "presentation",
    "backendRecords",
    "recoveredVariables",
    "typeCandidates",
    "warnings",
    "resourceUsage",
    "contentHash"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "address": {
      "type": "string",
      "pattern": "^(?:0x0|0x[1-9a-f][0-9a-f]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageId",
        "startAddress",
        "endAddressExclusive"
      ],
      "properties": {
        "imageId": {
          "$ref": "#/$defs/identifier"
        },
        "startAddress": {
          "$ref": "#/$defs/address"
        },
        "endAddressExclusive": {
          "$ref": "#/$defs/address"
        }
      }
    },
    "loadImageModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "byteOrder",
        "pointerWidthBits",
        "relocationModel",
        "fixupModel",
        "patchPolicy",
        "authenticatedPointerTreatment",
        "supportedRelocationKinds",
        "supportedFixupKinds"
      ],
      "properties": {
        "architecture": {
          "const": "AArch64"
        },
        "byteOrder": {
          "const": "little"
        },
        "pointerWidthBits": {
          "const": 64
        },
        "relocationModel": {
          "const": "mach-o-arm64-relocation-subset-v1"
        },
        "fixupModel": {
          "const": "dyld-chained-pointer-normalization-v1"
        },
        "patchPolicy": {
          "const": "fail-closed-mapped-preserve-unmapped"
        },
        "authenticatedPointerTreatment": {
          "const": "materialize-unsigned-target-with-authentication-evidence"
        },
        "supportedRelocationKinds": {
          "const": [
            "ARM64_RELOC_UNSIGNED",
            "ARM64_RELOC_BRANCH26",
            "ARM64_RELOC_PAGE21",
            "ARM64_RELOC_GOT_LOAD_PAGE21",
            "ARM64_RELOC_TLVP_LOAD_PAGE21",
            "ARM64_RELOC_PAGEOFF12",
            "ARM64_RELOC_GOT_LOAD_PAGEOFF12",
            "ARM64_RELOC_TLVP_LOAD_PAGEOFF12"
          ]
        },
        "supportedFixupKinds": {
          "const": [
            "DYLD_CHAINED_REBASE64",
            "DYLD_CHAINED_BIND64",
            "DYLD_CHAINED_AUTH_REBASE64",
            "DYLD_CHAINED_AUTH_BIND64"
          ]
        }
      }
    },
    "effectiveMemoryRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "startAddress",
        "endAddressExclusive",
        "permissions",
        "byteCount",
        "rawSha256",
        "effectiveSha256",
        "appliedPatchIds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "startAddress": {
          "$ref": "#/$defs/address"
        },
        "endAddressExclusive": {
          "$ref": "#/$defs/address"
        },
        "permissions": {
          "type": "string",
          "pattern": "^[r-][w-][x-]$"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "rawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "effectiveSha256": {
          "$ref": "#/$defs/sha256"
        },
        "appliedPatchIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^patch[0-9]{6}$"
          },
          "maxItems": 4096
        }
      }
    },
    "loadImagePatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceKind",
        "sourceIndex",
        "address",
        "width",
        "kind",
        "encoding",
        "targetAddress",
        "symbol",
        "addend",
        "authenticated",
        "key",
        "diversity",
        "originalBytesHex",
        "effectiveBytesHex",
        "sourceRange"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^patch[0-9]{6}$"
        },
        "sourceKind": {
          "enum": [
            "relocation",
            "fixup"
          ]
        },
        "sourceIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "width": {
          "enum": [
            4,
            8
          ]
        },
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "encoding": {
          "enum": [
            "littleEndianUnsigned64",
            "aarch64Branch26",
            "aarch64AdrpPage21",
            "aarch64AddImmediatePageOffset12",
            "aarch64UnsignedLoadStorePageOffset12",
            "normalizedPointer64"
          ]
        },
        "targetAddress": {
          "$ref": "#/$defs/address"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "addend": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "authenticated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "ia",
            "ib",
            "da",
            "db"
          ]
        },
        "diversity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 65535
        },
        "originalBytesHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2}){4,8}$"
        },
        "effectiveBytesHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2}){4,8}$"
        },
        "sourceRange": {
          "$ref": "#/$defs/sourceRange"
        }
      }
    },
    "unmappedAddressMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "sourceIndex",
        "address",
        "kind",
        "reason"
      ],
      "properties": {
        "sourceKind": {
          "enum": [
            "relocation",
            "fixup"
          ]
        },
        "sourceIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "reason": {
          "const": "outsideSuppliedMemory"
        }
      }
    },
    "loadImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "memoryRegions",
        "patches",
        "unmappedEvidence"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/loadImageModel"
        },
        "memoryRegions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectiveMemoryRegion"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "patches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loadImagePatch"
          },
          "maxItems": 4096
        },
        "unmappedEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unmappedAddressMetadata"
          },
          "maxItems": 8192
        }
      }
    }
  }
}
