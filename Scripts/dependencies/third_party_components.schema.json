{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macscope.invalid/schemas/third-party-components-v1.json",
  "title": "MacScope third-party component inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "distribution_policy", "components"],
  "properties": {
    "schema_version": {"const": 1},
    "distribution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "public_distribution_approved", "decision_record"],
      "properties": {
        "status": {
          "enum": ["private-development-only", "distribution-approved"]
        },
        "public_distribution_approved": {"type": "boolean"},
        "decision_record": {"type": "string", "minLength": 1}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "canonical_repository",
        "approval",
        "integration_mode",
        "license_expression",
        "pin",
        "tracked_paths",
        "materialization",
        "license_paths",
        "license_sha256",
        "notice_paths",
        "patches_path",
        "targets",
        "review",
        "notes"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "canonical_repository": {"type": "string", "pattern": "^https://"},
        "approval": {
          "enum": [
            "shipping-approved",
            "pilot-approved",
            "tooling-oracle-approved",
            "reference-only"
          ]
        },
        "integration_mode": {
          "enum": [
            "vendored-source",
            "external-pinned-source-build",
            "linked-library",
            "swift-package",
            "generated-data-corpus",
            "developer-tool",
            "external-oracle"
          ]
        },
        "license_expression": {"type": "string", "minLength": 1, "maxLength": 160},
        "pin": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "version": {"type": "string", "minLength": 1, "maxLength": 80},
            "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "source_archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "selected_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "tracked_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "materialization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "script",
            "network_allowed",
            "implicit_build_invocation",
            "expected_untracked_root"
          ],
          "properties": {
            "script": {"type": ["string", "null"]},
            "network_allowed": {"type": "boolean"},
            "implicit_build_invocation": {"const": false},
            "expected_untracked_root": {"type": ["string", "null"]}
          }
        },
        "license_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "license_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "notice_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "patches_path": {"type": "string", "minLength": 1},
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "status", "public_distribution_blocked", "reviewer"],
          "properties": {
            "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "status": {
              "enum": [
                "reviewed-private-development",
                "reviewed-shipping",
                "oracle-only",
                "pending"
              ]
            },
            "public_distribution_blocked": {"type": "boolean"},
            "reviewer": {"type": "string", "minLength": 1}
          }
        },
        "notes": {"type": "string", "maxLength": 2000}
      }
    }
  }
}
