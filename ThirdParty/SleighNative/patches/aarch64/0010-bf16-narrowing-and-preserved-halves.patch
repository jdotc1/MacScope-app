+# MacScope RX-17: BF16 is a bit encoding, not IEEE binary16.
+# FPConvertBF normal-result contract; exception processing stays an explicit effect.
+macro macscope_fp32_to_bf16(source, result) {
+    # Branch-free: every path is computed and combined with masks so each
+    # use stays inside one basic block.
+    local raw:4 = source;
+    local top:2 = raw[16,16];
+    local exponent:4 = (raw >> 23) & 0xff;
+    local fraction:4 = raw & 0x7fffff;
+    local discarded:4 = raw & 0xffff;
+    local negative:1 = (raw >> 31) != 0;
+    local alternate:1 = (fpcr & 2) != 0;
+    local bfMode:8 = ((fpcr >> 22) & 3) * zext(!alternate);
+    local isSpecial:1 = exponent == 0xff;
+    local isZeroExp:1 = exponent == 0;
+    local isNaN:1 = isSpecial & (fraction != 0);
+    local isDenormal:1 = isZeroExp & (fraction != 0);
+    local fzBit:1 = (fpcr & 0x1000000) != 0;
+    local flushFZ:1 = isDenormal & !alternate & fzBit;
+    local flush:1 = isDenormal & (alternate | fzBit | ((fpcr & 1) != 0));
+    local denormalRound:1 = isDenormal & !flush;
+    local rounds:1 = (!isSpecial & !isZeroExp) | denormalRound;
+    local inexact:1 = rounds & (discarded != 0);
+    local nearestIncrement:1 = (discarded > 0x8000) | ((discarded == 0x8000) & ((top & 1) != 0));
+    local directedIncrement:1 = ((bfMode == 1) & !negative) | ((bfMode == 2) & negative);
+    local increment:1 = inexact & (((bfMode == 0) & nearestIncrement) | ((bfMode != 0) & directedIncrement));
+    local rounded:2 = top + zext(increment);
+    local overflow:1 = inexact & ((rounded & 0x7f80) == 0x7f80);
+    # Preserve the NaN payload, quiet sNaN, and obey default-NaN selection.
+    local defaultNaN:1 = (fpcr & 0x2000000) != 0;
+    local defaultTop:2 = 0x7fc0 | (zext(alternate) << 15);
+    local nanTop:2 = ((top | 0x40) * zext(!defaultNaN)) | (defaultTop * zext(defaultNaN));
+    local signalling:1 = isNaN & ((raw & 0x400000) == 0);
+    local roundedSel:2 = 0 - zext(rounds);
+    local nanSel:2 = 0 - zext(isNaN);
+    local flushSel:2 = 0 - zext(flush);
+    local keepSel:2 = ~(roundedSel | nanSel | flushSel);
+    top = (rounded & roundedSel) | (nanTop & nanSel) | (top & 0x8000 & flushSel) | (top & keepSel);
+    local invalidBit:8 = zext(signalling);
+    local overflowBit:8 = zext(overflow);
+    local underflowBit:8 = zext(denormalRound & ((discarded != 0) | ((fpcr & 0x800) != 0)));
+    local inexactBit:8 = zext(inexact);
+    local denormalBit:8 = zext(flushFZ);
+    local exceptions:8 = (invalidBit | (overflowBit << 2) | (underflowBit << 3) | (inexactBit << 4) | (denormalBit << 7)) * zext(!alternate);
+    local raisedStatus:8 = ARM64FPProcessExceptions(exceptions, fpcr, fpsr);
+    local raised:8 = 0 - zext(exceptions != 0);
+    fpsr = (raisedStatus & raised) | (fpsr & ~raised);
+    result = top;
+}
