 @endif
 Re_VPR128Lo.H.vIndexHLM: Re_VPR128Lo.H^"["^vIndexHLM^"]" is Re_VPR128Lo.H & vIndexHLM & Re_VPR128Lo.H.sel { export Re_VPR128Lo.H.sel; }
+
+# FHM and BFMLAL use H:L:M even though bits[23:22] are 2 or 3.
+# Keep this separate from vIndexHLM, whose size-dependent semantics are used
+# by other Advanced SIMD instruction classes.
+vIndexFullHLM: val is b_1111 & b_2121 & b_2020
+    [ val = b_1111 << 2 | b_2121 << 1 | b_2020; ] { export *[const]:8 val; }
+@if DATA_ENDIAN == "little"
+Re_VPR128Lo.H.selFullHLM: Re_VPR128Lo, val
+is Re_VPR128Lo & b_1111 & b_2121 & b_2020
+    [ val = 0x5000 + 32*Re_VPR128Lo + (b_1111*4 + b_2121*2 + b_2020)*2; ]
+    { export *[register]:2 val; }
+@else
+Re_VPR128Lo.H.selFullHLM: Re_VPR128Lo, val
+is Re_VPR128Lo & b_1111 & b_2121 & b_2020
+    [ val = 0x501e + 32*Re_VPR128Lo - (b_1111*4 + b_2121*2 + b_2020)*2; ]
+    { export *[register]:2 val; }
+@endif
+Re_VPR128Lo.H.vIndexFullHLM: Re_VPR128Lo.H^"["^vIndexFullHLM^"]"
+is Re_VPR128Lo.H & vIndexFullHLM & Re_VPR128Lo.H.selFullHLM
+    { export Re_VPR128Lo.H.selFullHLM; }
 
 FBitsOp: "#"^fbits is Scale [ fbits = 64 - Scale; ] { export *[const]:2 fbits; }
 
