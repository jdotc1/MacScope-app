+# MacScope RX-17b: FPRoundIntN returns an integral FLOAT, not integer bits.
+# Bit-level rounding avoids host rounding modes and conversion overflow. Explicit
+# invalid/inexact effects retain the existing ARM64FPProcessExceptions boundary.
+macro macscope_frintn(source, result, fractionBits, exponentMask, bias, signMask, intBits, mode) {
+    # Branch-free: every path is computed and combined with masks so each
+    # use stays inside one basic block; shift counts are bounded to 0..63.
+    local raw:8 = zext(source);
+    local exponent:8 = (raw >> fractionBits) & exponentMask;
+    local fraction:8 = raw & ((1:8 << fractionBits) - 1);
+    local negative:1 = (raw & signMask) != 0;
+    local limit:8 = 1:8 << (intBits - 1);
+    local isSpecial:1 = exponent == exponentMask;
+    local isZeroExp:1 = exponent == 0;
+    local isDenormal:1 = isZeroExp & (fraction != 0);
+    # FZ is ignored with AH; FIZ still flushes, without an input-denormal flag.
+    local flushFZ:1 = isDenormal & ((fpcr & 0x1000000) != 0) & ((fpcr & 2) == 0);
+    local flushFIZ:1 = isDenormal & !flushFZ & ((fpcr & 1) != 0);
+    local finite:1 = !isSpecial & (!isZeroExp | (isDenormal & !flushFZ & !flushFIZ));
+    local tooLarge:1 = exponent >= bias + intBits;
+    local small:1 = exponent < bias;
+    local integral:1 = exponent >= bias + fractionBits;
+    local fractionalPart:1 = !small & !integral;
+    local significand:8 = fraction | (1:8 << fractionBits);
+    local roundingShift:8 = (bias + fractionBits - exponent) & 63;
+    local integralShift:8 = (exponent - bias - fractionBits) & 63;
+    local magnitude:8 = ((significand >> roundingShift) * zext(fractionalPart)) | ((significand << integralShift) * zext(integral));
+    local smallDiscarded:8 = 1 + (zext(exponent == bias - 1) * (1 + zext(fraction != 0)));
+    local discarded:8 = ((significand & ((1:8 << roundingShift) - 1)) * zext(fractionalPart)) | (smallDiscarded * zext(small));
+    local halfway:8 = ((1:8 << ((roundingShift - 1) & 63)) * zext(fractionalPart)) | (2 * zext(small));
+    local inexact:1 = discarded != 0;
+    local nearestIncrement:1 = (discarded > halfway) | ((discarded == halfway) & ((magnitude & 1) != 0));
+    local directedIncrement:1 = ((mode == 1) & !negative) | ((mode == 2) & negative);
+    local increment:1 = inexact & (((mode == 0) & nearestIncrement) | ((mode != 0) & directedIncrement));
+    magnitude = magnitude + zext(increment);
+    local invalid:1 = isSpecial | (finite & (tooLarge | (magnitude > limit) | ((magnitude == limit) & !negative)));
+    local signFill:8 = 0 - zext(negative);
+    local signedMagnitude:8 = (magnitude ^ signFill) - signFill;
+    local value:8 = (signedMagnitude * zext(finite & !invalid)) | ((0 - limit) * zext(invalid));
+    # Zero results (integral, signed-zero and flushed inputs) keep the source sign;
+    # every other negative input already converts to a negative float, so OR-ing
+    # the source sign bit is exact.
+    result = int2float(value);
+    result = result | (source & signMask);
+    local invalidBit:8 = zext(invalid);
+    local inexactBit:8 = zext(finite & !invalid & inexact);
+    local denormalBit:8 = zext(flushFZ);
+    local exceptions:8 = invalidBit | (inexactBit << 4) | (denormalBit << 7);
+    local raisedStatus:8 = ARM64FPProcessExceptions(exceptions, fpcr, fpsr);
+    local raised:8 = 0 - zext(exceptions != 0);
+    fpsr = (raisedStatus & raised) | (fpsr & ~raised);
+}
