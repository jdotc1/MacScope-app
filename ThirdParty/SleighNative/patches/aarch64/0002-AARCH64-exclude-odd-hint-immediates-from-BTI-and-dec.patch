From 7d61faa45dca5fee0f17c989d4abaaaf3e984007 Mon Sep 17 00:00:00 2001
From: MacScope <macscope@invalid>
Date: Mon, 12 Oct 2026 00:00:00 +0000
Subject: [PATCH 2/3] AARCH64: exclude odd hint immediates from BTI and decode
 PACM

BTI is HINT #32/#34/#36/#38. The :bti constructor tested bits[11:8]
and bits[7:6] but not bit 5, so HINT #33/#35/#37/#39 decoded as bti.
HINT #39 is PACM (FEAT_PAuth_LR), which now has its own constructor.
---
 .../data/languages/AARCH64_PAuthLR_MOPS_THE.sinc      | 11 +++++++++++
 .../AARCH64/data/languages/AARCH64base.sinc           |  4 ++--
 .../AARCH64/data/languages/AARCH64instructions.sinc   |  1 +
 3 files changed, 14 insertions(+), 2 deletions(-)
 create mode 100644 Ghidra/Processors/AARCH64/data/languages/AARCH64_PAuthLR_MOPS_THE.sinc

diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64_PAuthLR_MOPS_THE.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64_PAuthLR_MOPS_THE.sinc
new file mode 100644
index 0000000..451b682
--- /dev/null
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64_PAuthLR_MOPS_THE.sinc
@@ -0,0 +1,11 @@
+# FEAT_PAuth_LR, FEAT_MOPS and FEAT_THE constructors that are not part of the
+# upstream base specification.
+
+# PACM page pacm.html (Arm A-profile 2026-03) MATCH xd50324ff/mask=xffffffff
+# PACM is HINT #39. It sets PSTATE.PACM so that the next PAC instruction uses its
+# second modifier; without FEAT_PAuth_LR it executes as a NOP. No p-code is
+# emitted here.
+:pacm
+is b_0031=0xd50324ff
+{
+}
diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
index b957815..b1b2628 100644
--- a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
@@ -7428,10 +7428,10 @@ is b_1231=0b11010101000000000100 & b_0007=0b01011111
 
 # C6.2.41 BTI page C6-1214 line 71457 MATCH xd503241f/mask=xffffff3f
 # C6.2.126 HINT page C6-1480 line 88030 MATCH xd503201f/mask=xfffff01f
-# CONSTRUCT xd503241f/mask=xffffff1f MATCHED 2 DOCUMENTED OPCODES
+# CONSTRUCT xd503241f/mask=xffffff3f MATCHED 2 DOCUMENTED OPCODES
 
 :bti BTI_BTITARGETS
-is BTI_BTITARGETS & b_1231=0xd5032 & b_0811=4 & b_0004=0x1f
+is BTI_BTITARGETS & b_1231=0xd5032 & b_0811=4 & b_05=0 & b_0004=0x1f
 {
 	# This instruction is a valid target for jumps, calls, or both; see the BTI_BTITARGETS table.
 }
diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64instructions.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64instructions.sinc
index 03afdd1..da9390a 100644
--- a/Ghidra/Processors/AARCH64/data/languages/AARCH64instructions.sinc
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64instructions.sinc
@@ -3976,6 +3976,7 @@ is ImmS_ImmR_TestSet=0 & ImmR & ImmS & instruction
 with : ImmS_ImmR_TestSet=1 {
 	
 @include "AARCH64_base_PACoptions.sinc"
+@include "AARCH64_PAuthLR_MOPS_THE.sinc"
 
 @include "AARCH64base.sinc"
 @include "AARCH64neon.sinc"
