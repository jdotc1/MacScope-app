# MacScope RX-18 Wave 3. Architectural encodings from Arm A64 XML tables.
# SVL is symbolic; ZA is an opaque state token, NOT a fixed-size integer tile.
# EffectsUnmodelled operations retain state dependencies/clobbers, never numeric
# semantics. Existing Z/P registers have a fixed width; scalable execution and
# native provider acceptance remain explicitly unqualified. ZT0 is exactly 512b.
define register offset=0x7000 size=8 [ sme_svl_bytes sme_za_state ];
define register offset=0x7040 size=64 [ zt0 ];
define pcodeop SME_ZERO_EffectsUnmodelled;
define pcodeop SME_ZA_LOAD_EffectsUnmodelled;
define pcodeop SME_ZA_STORE_EffectsUnmodelled;
define pcodeop SME_FMOPA_EffectsUnmodelled;
define pcodeop SME_FPStatus_EffectsUnmodelled;
define pcodeop SME_LUTI2_EffectsUnmodelled;
define pcodeop SME_MOVA_FROM_ZA_EffectsUnmodelled;
define pcodeop SME_MOVA_TO_ZA_EffectsUnmodelled;
define pcodeop SME_ZA_ST1_EffectsUnmodelled;
define pcodeop SME_ZA_LD1_EffectsUnmodelled;
define pcodeop SME_ADD_EffectsUnmodelled;
define pcodeop SME_STREAMING_EffectsUnmodelled;
attach variables [sme_ws] [w12 w13 w14 w15];
attach variables [sme_pn sme_pm] [p0 p1 p2 p3 p4 p5 p6 p7];

