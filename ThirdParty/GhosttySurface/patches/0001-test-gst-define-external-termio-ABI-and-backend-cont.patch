diff --git a/include/ghostty.h b/include/ghostty.h
index ac7df2b37..bed533a3e 100644
--- a/include/ghostty.h
+++ b/include/ghostty.h
@@ -1037,6 +1037,134 @@ typedef struct {
   ghostty_runtime_close_surface_cb close_surface_cb;
 } ghostty_runtime_config_s;
 
+//-------------------------------------------------------------------
+// Private external-I/O ABI (v1). MacScope host-fed surfaces.
+//
+// An external surface is fed already-authorized terminal output bytes by
+// the embedding host and returns terminal-generated input bytes, resize
+// proposals, and lifecycle notifications through the callbacks below.
+// Ghostty never launches, owns, resizes, signals, or waits for a child
+// process or PTY for an external surface.
+//
+// Contract summary (authoritative documentation: src/termio/External.zig
+// and ABI_CONTRACT_V1.md in the integration return):
+//
+//   - Versioning: every struct is size-prefixed. struct_size must be at
+//     least the v1 size and abi_version must be
+//     GHOSTTY_EXTERNAL_IO_ABI_VERSION; larger future structs are read
+//     only through their v1 prefix. Unknown versions, undersized
+//     structs, null required callbacks, and invalid enum values fail
+//     closed (surface creation returns NULL; calls return INVALID).
+//   - Threading: feed/set_process_state/is_external_io may be called
+//     from any host thread and may safely race with
+//     ghostty_surface_free (they return CLOSED once destruction
+//     begins). Every callback is invoked on Ghostty's termio io thread,
+//     with no internal lock held. No callback occurs after
+//     ghostty_surface_free returns.
+//   - Buffers: feed copies any bytes it retains before returning; a
+//     callback buffer is valid only for the duration of the callback.
+//     Feeds are all-or-nothing: ACCEPTED consumed the whole buffer,
+//     every other result consumed nothing.
+//   - Queues: the inbound mailbox and pending-output buffer are bounded
+//     (1 MiB / 1024 chunks inbound, 256 KiB pending output). A feed
+//     that cannot fit right now returns BACKPRESSURED; after the
+//     mailbox drains, the optional health callback reports FEED_READY
+//     and a retry will succeed. A feed larger than the total capacity
+//     returns INVALID.
+//   - Reentrancy: callbacks must not call ghostty_surface_free (or
+//     block on a thread calling it); calling feed/set_process_state
+//     from a callback is allowed.
+//   - Lifecycle: set_process_state transitions are validated; terminal
+//     states (EXITED/SIGNALED/CLOSED) latch, never regress to RUNNING,
+//     and preserve the final screen and scrollback. After a terminal
+//     state, feed returns CLOSED and generated output/resize callbacks
+//     are suppressed (reported once via OUTPUT_SUPPRESSED). The close
+//     callback fires at most once per surface: either echoing the
+//     host-reported terminal state or requesting a close on Ghostty's
+//     behalf (CLOSE_SURFACE_REQUEST).
+
+#define GHOSTTY_EXTERNAL_IO_ABI_VERSION 1
+
+// termio.External.Result
+typedef enum {
+  GHOSTTY_EXTERNAL_IO_ACCEPTED = 0,
+  GHOSTTY_EXTERNAL_IO_BACKPRESSURED = 1,
+  GHOSTTY_EXTERNAL_IO_CLOSED = 2,
+  GHOSTTY_EXTERNAL_IO_INVALID = 3,
+  GHOSTTY_EXTERNAL_IO_INTERNAL_ERROR = 4,
+} ghostty_external_io_result_e;
+
+// termio.External.ProcessStateKind
+typedef enum {
+  GHOSTTY_EXTERNAL_PROCESS_RUNNING = 0,
+  GHOSTTY_EXTERNAL_PROCESS_EXITED = 1,
+  GHOSTTY_EXTERNAL_PROCESS_SIGNALED = 2,
+  GHOSTTY_EXTERNAL_PROCESS_CLOSED = 3,
+} ghostty_external_process_state_e;
+
+// termio.External.CloseReason
+typedef enum {
+  GHOSTTY_EXTERNAL_CLOSE_HOST_EXITED = 0,
+  GHOSTTY_EXTERNAL_CLOSE_HOST_SIGNALED = 1,
+  GHOSTTY_EXTERNAL_CLOSE_HOST_CLOSED = 2,
+  GHOSTTY_EXTERNAL_CLOSE_SURFACE_REQUEST = 3,
+} ghostty_external_close_reason_e;
+
+// termio.External.HealthEvent
+typedef enum {
+  GHOSTTY_EXTERNAL_HEALTH_FEED_READY = 0,
+  GHOSTTY_EXTERNAL_HEALTH_OUTPUT_BACKPRESSURED = 1,
+  GHOSTTY_EXTERNAL_HEALTH_OUTPUT_OVERFLOW = 2,
+  GHOSTTY_EXTERNAL_HEALTH_OUTPUT_SUPPRESSED = 3,
+} ghostty_external_health_event_e;
+
+// Terminal-generated bytes for the host to deliver to its session. The
+// buffer is valid only during the call. Return ACCEPTED (all bytes
+// consumed), BACKPRESSURED (nothing consumed; Ghostty retains the bytes
+// in a bounded buffer and retries), or CLOSED (output channel is
+// permanently unavailable). Out-of-range returns are treated as CLOSED.
+typedef ghostty_external_io_result_e (*ghostty_external_write_cb)(void*,
+                                                                  const uint8_t*,
+                                                                  size_t);
+
+// Proposed geometry: columns, rows, pixel width, pixel height. Identical
+// consecutive proposals are coalesced; a proposal precedes the terminal
+// grid applying the new size.
+typedef void (*ghostty_external_resize_cb)(void*,
+                                           uint16_t,
+                                           uint16_t,
+                                           uint32_t,
+                                           uint32_t);
+
+// Session close notification/request. Invoked at most once per surface.
+typedef void (*ghostty_external_close_cb)(void*,
+                                          ghostty_external_close_reason_e);
+
+// Optional bounded diagnostics. detail is the byte count associated with
+// the event. Events are edge-triggered and latched (one callback per
+// condition, never per byte).
+typedef void (*ghostty_external_health_cb)(void*,
+                                           ghostty_external_health_event_e,
+                                           uint64_t);
+
+typedef struct {
+  size_t struct_size;    // sizeof(ghostty_external_io_config_s)
+  uint32_t abi_version;  // GHOSTTY_EXTERNAL_IO_ABI_VERSION
+  void* userdata;
+  ghostty_external_write_cb write_cb;    // required
+  ghostty_external_resize_cb resize_cb;  // required
+  ghostty_external_close_cb close_cb;    // required
+  ghostty_external_health_cb health_cb;  // optional, may be NULL
+} ghostty_external_io_config_s;
+
+typedef struct {
+  size_t struct_size;    // sizeof(ghostty_external_process_state_s)
+  uint32_t abi_version;  // GHOSTTY_EXTERNAL_IO_ABI_VERSION
+  int32_t state;         // ghostty_external_process_state_e
+  uint32_t exit_code;    // valid when state == EXITED
+  uint32_t signal;       // valid when state == SIGNALED
+} ghostty_external_process_state_s;
+
 // apprt.ipc.Target.Key
 typedef enum {
   GHOSTTY_IPC_TARGET_CLASS,
@@ -1114,6 +1242,24 @@ GHOSTTY_API ghostty_surface_t ghostty_surface_new(ghostty_app_t,
                                                      const ghostty_surface_config_s*);
 GHOSTTY_API void ghostty_surface_free(ghostty_surface_t);
 GHOSTTY_API void* ghostty_surface_userdata(ghostty_surface_t);
+
+// Private external-I/O ABI v1 (see the typedef block above for the
+// contract). ghostty_surface_new_external fails closed (returns NULL)
+// on any invalid config. feed/set_process_state/is_external_io are
+// callable from any host thread and safe against surface destruction.
+GHOSTTY_API ghostty_surface_t ghostty_surface_new_external(
+    ghostty_app_t,
+    const ghostty_surface_config_s*,
+    const ghostty_external_io_config_s*);
+GHOSTTY_API ghostty_external_io_result_e ghostty_surface_external_feed(
+    ghostty_surface_t,
+    const uint8_t*,
+    size_t);
+GHOSTTY_API ghostty_external_io_result_e
+ghostty_surface_external_set_process_state(
+    ghostty_surface_t,
+    const ghostty_external_process_state_s*);
+GHOSTTY_API bool ghostty_surface_is_external_io(ghostty_surface_t);
 GHOSTTY_API ghostty_app_t ghostty_surface_app(ghostty_surface_t);
 GHOSTTY_API ghostty_surface_config_s ghostty_surface_inherited_config(ghostty_surface_t, ghostty_surface_context_e);
 GHOSTTY_API void ghostty_surface_update_config(ghostty_surface_t, ghostty_config_t);
