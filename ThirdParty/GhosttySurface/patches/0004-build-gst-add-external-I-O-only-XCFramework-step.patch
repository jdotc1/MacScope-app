From 060958c871149c1835dfc1fdb4d90d71ebf4ec0e Mon Sep 17 00:00:00 2001
From: MacScope contributors <contributors@macscope.invalid>
Date: Wed, 26 Aug 2026 16:16:21 -0400
Subject: [PATCH 4/4] build(gst): add external-I/O-only XCFramework step

Expose an explicit build graph edge for the MacScope private external-I/O surface. The step depends only on the XCFramework and excludes Ghostty install resources such as terminfo, shell integrations, completions, syntax files, translations, docs, themes, and web payloads.
---
 build.zig | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/build.zig b/build.zig
index acf19ac91..684c2167a 100644
--- a/build.zig
+++ b/build.zig
@@ -219,6 +219,16 @@ pub fn build(b: *std.Build) !void {
             config.xcframework_target,
         );
         if (config.emit_xcframework) {
+            // MacScope consumes only the private external-I/O XCFramework.
+            // This explicit step deliberately omits Ghostty's application
+            // resources (terminfo, shell integration, completions, syntax
+            // files, translations, and other install-only payloads).
+            const macscope_xcframework_step = b.step(
+                "macscope-xcframework",
+                "Build only the MacScope external-I/O XCFramework",
+            );
+            xcframework.addStepDependencies(macscope_xcframework_step);
+
             xcframework.install();
 
             // The xcframework build always installs resources because our
